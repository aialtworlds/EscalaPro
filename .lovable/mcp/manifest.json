{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://cwmtwjkhvjffhtxzsqox.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "escalapro-os",
      "version": "0.1.0",
      "title": "EscalaPro OS"
    },
    "tools": [
      {
        "name": "list_sectors",
        "title": "Listar setores",
        "description": "Lista todos os setores operacionais do usuário autenticado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_employees",
        "title": "Listar funcionários",
        "description": "Lista os funcionários (colaboradores) do usuário. Opcionalmente filtra por setor.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "sector_id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID do setor para filtrar. Opcional."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_shifts_by_day",
        "title": "Escala do dia",
        "description": "Lista os turnos (escala operacional) de um dia específico. Data em formato YYYY-MM-DD.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Data no formato YYYY-MM-DD."
            },
            "sector_id": {
              "type": "string",
              "format": "uuid",
              "description": "Filtro opcional por setor."
            }
          },
          "required": [
            "date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_shifts_by_week",
        "title": "Escala da semana",
        "description": "Lista todos os turnos de uma semana a partir do dia inicial (YYYY-MM-DD, geralmente segunda-feira).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "week_start": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Data inicial da semana (YYYY-MM-DD)."
            }
          },
          "required": [
            "week_start"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_shift",
        "title": "Criar turno",
        "description": "Cria um novo turno na escala. Pode ser um turno regular (empregado + setor), extra ou de freelancer.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "shift_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Data (YYYY-MM-DD)."
            },
            "start_time": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$",
              "description": "Início (HH:MM)."
            },
            "end_time": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$",
              "description": "Fim (HH:MM)."
            },
            "sector_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "employee_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Funcionário CLT. Deixe null para freelancer."
            },
            "is_freelancer": {
              "type": "boolean",
              "default": false
            },
            "freelancer_label": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ],
              "description": "Nome do freelancer, quando aplicável."
            },
            "is_extra": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "shift_date",
            "start_time",
            "end_time"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "mark_shift_absent",
        "title": "Registrar falta",
        "description": "Marca um turno como falta e registra uma ausência para o funcionário.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "shift_id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID do turno."
            },
            "reason": {
              "type": "string",
              "maxLength": 240,
              "description": "Motivo opcional."
            }
          },
          "required": [
            "shift_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "recent_activity",
        "title": "Atividade recente",
        "description": "Lista os eventos operacionais mais recentes registrados pelo sistema.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Padrão 25."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
